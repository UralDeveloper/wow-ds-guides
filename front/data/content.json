        { "h": "Подготовка", "p": "Состав и подготовка перед пулом.", "tips": ["Два танка обязательно: бой построен на свапе.", "Минимум 4 хила на героике, 5 на эпохальном.", "Распределите сейвы рейда по таймлайну заранее."] },
        { "h": "Фаза 1", "p": "Босс в центре, рейд стоит по схеме на карте. Главное — свап танков и вынос луж к краю.", "tips": ["Танки меняются на 3 стаке «Давления глубины».", "Лужи уводить по маршруту, не через центр."] },
        { "h": "Переход", "p": "На 60% босс уходит под воду, рейд перебегает на северную платформу по мосту.", "tips": ["Не стоять в центре: там зона урона.", "Хилы держат массовые КД на прилив."] },
        { "h": "Фаза 2", "p": "Появляются адды со щитом, урон по рейду растёт.", "tips": ["ДД сначала сбивают каст аддов, потом фокусят.", "Танки продолжают свап по тем же правилам."] },
        { "h": "Частые ошибки", "p": "Из-за чего вайпаются чаще всего.", "tips": ["Лужа брошена в центре — рейду некуда встать.", "Свап запоздал на один стак — танк умирает.", "Сейвы потрачены рано, к третьему обвалу нечем прожать."] }
      ]
    }
