  "tactics": {
    "t1": {
      "summary": "Разминочный бой: один танк держит босса, рейд разбирается с волнами аддов у ворот.",
      "tags": ["1 фаза", "Адды", "Сбивание кастов"],
      "mechs": [
        { "name": "Удар тараном", "role": "tank", "timer": "каждые 18 с", "sev": "важно", "text": "Сильный удар по танку. Держать защитный КД на каждый второй каст." },
        { "name": "Стража ворот", "role": "dd", "timer": "каждые 40 с", "sev": "крит", "text": "Волна аддов из ворот. Сбивайте лечение у жрецов в первую очередь." },
        { "name": "Осадный залп", "role": "heal", "timer": "каждые 35 с", "sev": "важно", "text": "Урон по случайным игрокам. Точечное лечение, массовые КД не нужны." },
        { "name": "Горящая смола", "role": "all", "timer": "постоянно", "sev": "инфо", "text": "Лужи смолы у стен. Держитесь центра арены." }
      ]
    },
    "t2": {
      "summary": "Бой на выносливость: свап танков по стакам, лужи уводим к краю, на 60% переход на северную платформу.",
      "tags": ["2 фазы", "Свап танков", "Сейвы рейда"],
      "mechs": [
        { "name": "Давление глубины", "role": "tank", "timer": "каждые 20 с", "sev": "крит", "text": "Стакающийся дебафф на текущей цели. Свап на 3 стаке, второй танк забирает босса сразу." },
        { "name": "Обвал свода", "role": "heal", "timer": "каждые 45 с", "sev": "важно", "text": "Урон по всему рейду, растёт с каждым кастом. Распределите сейвы по таймлайну." },
        { "name": "Тёмные воды", "role": "all", "timer": "каждые 30 с", "sev": "важно", "text": "Под тремя игроками появляются лужи. Уводите их к краю арены по маршруту на карте." },
        { "name": "Порождения бездны", "role": "dd", "timer": "фаза 2", "sev": "крит", "text": "Адды с щитом. Сначала сбить каст, затем убить за 40 секунд." },
        { "name": "Зов глубин", "role": "all", "timer": "на 60%", "sev": "инфо", "text": "Переход: все собираются на северной платформе, пока босс под водой." },
        { "name": "Разлом", "role": "dd", "timer": "каждые 25 с", "sev": "инфо", "text": "Фронтальный конус. Не стоять перед боссом, бить со спины." }
      ]
    },
    "t3": {
      "summary": "Бой с контролем освещения: рейд держится в световых кругах, иначе получает урон от тьмы.",
      "tags": ["3 фазы", "Позиционка", "Разбегание"],
      "mechs": [
        { "name": "Затмение", "role": "all", "timer": "каждые 50 с", "sev": "крит", "text": "Свет гаснет. Встать в ближайший световой круг до конца каста." },
        { "name": "Поглощение", "role": "tank", "timer": "каждые 24 с", "sev": "важно", "text": "Хилы по танку срезаются вдвое на 8 секунд. Используйте личный сейв." },
        { "name": "Осколки тьмы", "role": "dd", "timer": "фаза 2", "sev": "важно", "text": "Медленные осколки ползут к рейду. Убить до того, как дойдут." },
        { "name": "Мерцание", "role": "heal", "timer": "каждые 30 с", "sev": "инфо", "text": "Дебафф на хилах: разбежаться на 8 метров, чтобы не задеть других." }
      ]
    },
    "t4": {
      "summary": "Три босса с общим здоровьем. Убивать одновременно, разница больше 10% даёт усиление выжившим.",
      "tags": ["3 цели", "Клив", "Синхронный килл"],
      "mechs": [
        { "name": "Связь крови", "role": "all", "timer": "постоянно", "sev": "крит", "text": "Боссы делят урон. Держите разницу по здоровью не больше 10%." },
        { "name": "Теневой выпад", "role": "tank", "timer": "каждые 15 с", "sev": "важно", "text": "Прыжок на дальнюю цель. Танк перехватывает босса после прыжка." },
        { "name": "Ритуал совета", "role": "dd", "timer": "на 30%", "sev": "крит", "text": "Каст, который нужно сбить у всех трёх боссов в течение 5 секунд." },
        { "name": "Мор", "role": "heal", "timer": "каждые 40 с", "sev": "важно", "text": "Диспел болезни с двух игроков. Не диспелить, пока они рядом с рейдом." }
      ]
    }
